        "authoritative_source": "rules.pdf",
        "facts": [
          "Benchmark Suite / invoice-reconciliation-evaluation",
          "Authoritative rules - all dates inclusive; all money SGD.",
          "Business cutoff: 2026-11-18. Use this date, not the computer clock.",
          "Invoice business key = (vendor_id, invoice_id). Copies across registers are duplicates.",
          "Deduplicate invoices by greatest (updated_on, revision) on/before cutoff BEFORE filtering status.",
          "Only latest POSTED invoices issued on/before cutoff enter reconciliation; VOID/DRAFT excluded.",
          "Credit notes deduplicate by credit_id; payments by payment_id (greatest updated_on, revision).",
          "Apply only POSTED credits and SETTLED payments, with event_on and updated_on <= cutoff.",
          "Match both vendor_id and invoice_id. PENDING/FAILED/REVERSED payments do not reduce balance.",
          "Amounts are already tax-inclusive; do not recalculate tax. No cross-invoice netting.",
          "Balance = gross - applicable credits - settled payments, rounded half up to cents.",
          "Output ALL posted invoices, including zero balances and partially paid invoices.",
          "Status: negative=CREDIT_BALANCE; zero=SETTLED; positive and due_on<cutoff=OVERDUE;",
          "otherwise OPEN. A due date equal to cutoff is OPEN. Do not trust printed paid badges.",
          "",
          "Deliver reconciliation.csv as UTF-8 CSV, exact header:",
          "vendor_id,invoice_id,gross_sgd,credit_sgd,paid_sgd,outstanding_sgd,due_on,status",
          "Row order does not affect grading. Numbers without currency signs or thousands separators.",
          "Upload the CSV to the same ownCloud case folder. Share the CSV publicly (no password/login).",
          "Save only its public URL in local link.txt and post that URL in the suite RocketChat room."
        ],
        "no_dynamic_model": true,
        "no_answer_or_qualifying_ids": true,
        "out_of_scope_reply": "Use this case's published source PDFs; no extra facts or computed answers are available."
